# Uzņēmuma rekvizīti (distances līgums, GDPR, Stripe — jāsaskan ar konta īpašnieku)
# SDV: parasti Vārds Uzvārds + personas kods kā reģ. nr. | IK: piem. „IK PROVIN” + UR numurs
# Stripe: verifikācijā — SDV dokumenti; Dashboard „Public business” — PROVIN.LV; kājene — īstais vārds (saskan ar kontu)
# Bankas izraksts: bieži STRIPE* PROVIN.LV
# Opcionāli: publiskais zīmols kājenē (noklusējums PROVIN.LV)
# NEXT_PUBLIC_COMPANY_PUBLIC_BRAND=PROVIN.LV
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_REG_NO=
# Juridiskā adrese — jāsaskan ar Stripe konta verifikāciju un UR/EDS (kājene izmanto to pašu tekstu)
# NEXT_PUBLIC_COMPANY_LEGAL_ADDRESS=Jana iela 3, Tukums, LV3101, Latvija
NEXT_PUBLIC_COMPANY_LEGAL_ADDRESS=

# IRISS piedāvājuma PDF / drukas HTML kājene: tikai servera env (nav publiskajā bundle; Stripe nedrīkst redzēt iekšējo piegādātāja adresi gitā).
# JSON masīvs ar teksta rindiņām (pirmajā zīmols). Pilnu saturu ieliec Vercel un lokālajā `.env.local`, necomitē repozitorijā.
# Piemērs struktūrai: IRISS_PDF_SUPPLIER_LINES_JSON=["SIA ĪRISS","Reģ. nr.: …","Juridiskā adrese: …","Faktiskā adrese: …","Banka: …","Kontakti: …","Tālrunis: …"]
# IRISS_PDF_SUPPLIER_LINES_JSON=

# Rēķins: opcionāli pilns PVN kājenes teksts (noklusējums: SDV, 139.2 īpašā kārtība, pārdošanai bez PVN)
# NEXT_PUBLIC_INVOICE_PVN_DISCLAIMER=
# PRV-YYYY-XXXX secība: Blob `_meta/invoice-year-sequence.json` (produkcija) vai `.data/admin-order-drafts/_meta/` (lokāli)

# Public site URL — obligāti ar shēmu (https://…), bez slīpsvītras beigās; SEO metadataBase / sitemap
# Lokāli: http://localhost:3000  |  Produkcija: https://provin.lv vai https://www.provin.lv
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PROVIN SELECT — pēc noklusējuma slēpts (kamēr `/test-pricing-5` ir primārais). Ieslēgt: 1 vai true.
# NEXT_PUBLIC_PROVIN_SELECT_PUBLIC=1
# Standalone `/provin-audits` — pēc noklusējuma slēpts. Ieslēgt: 1 vai true.
# NEXT_PUBLIC_PROVIN_AUDITS_STANDALONE_PUBLIC=1

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# Produkcijā: Dashboard → Webhooks → signing secret. Lokāli: `stripe listen` izdrukā whsec_… un ieliec šeit.
STRIPE_WEBHOOK_SECRET=whsec_...
# Testa cenu lapa /test-pricing-5 — Stripe Price ID (opcija; bez tiem tiek lietots price_data fallback).
# MINI (plus): 3999 centi = 39,99 € | AUDITS (premium): 9999 centi = 99,99 €
# STRIPE_PRICE_MINI=price_...
# STRIPE_PRICE_PLUS=price_...
# STRIPE_PRICE_PREMIUM=price_...

# Statistika (/admin/statistika) — ārējs analīzes panelis (https). Piemēram Plausible „share” embed vai GA saite.
# NEXT_PUBLIC_ANALYTICS_DASHBOARD_URL=https://plausible.io/...
# NEXT_PUBLIC_ANALYTICS_EMBED_URL=https://plausible.io/share/... (vai cits https iframe embed)

# Vercel projekts: Dashboard → Analytics → Enable Web Analytics (nav env atslēga).
# Speed Insights: Dashboard → Speed Insights → Enable (komponente `@vercel/speed-insights` kodā).

# Google Analytics 4 — mērījuma ID no GA (gtag.js). EEZ: Consent Mode / saskaņot ar CookieConsent un privātumu.
# Bez šī mainīgā GA4 netiek ielādēts (no-op). Produkcijā: Vercel → Environment Variables → Production.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Ads (AW-18517313147) - viens gtag.js ar GA4. Conversion label no Ads → Goals.
# Bez šī mainīgā purchase conversion uz /paldies netiek sūtīts.
# NEXT_PUBLIC_GADS_PURCHASE_LABEL=
# TikTok Pixel (ielādējas tikai pēc analītikas piekrišanas; noklusējums kodā - D8CKFMRC77UA4F3IGKA0)
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=D8CKFMRC77UA4F3IGKA0
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=0
# Meta Pixel (klients) + Conversions API (serveris). Bez šiem mainīgajiem viss ir no-op.
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_EVENT_CODE=

# Admin panelis (/admin)
# Lokāli (npm run dev): nav obligāti — izmantoti droši noklusējumi (tikai izstrāde, ne produkcija).
# Vercel / produkcija: obligāti visi trīs — ADMIN_SECRET ≥ 16 rakstzīmes (nejauša virkne).
ADMIN_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# B2B partneri (/admin/partneri, /lv/partneriem): JSON indekss Blob `b2b-partners/index.json` vai lokāli `.data/b2b-partners/`.
# Sesijas sīkdatne: B2B_PARTNER_SESSION_SECRET (ja tukšs, krīt uz ADMIN_SECRET; lokāli bez abiem - iebūvēts dev secret).
# B2B_PARTNER_SESSION_SECRET=
# Preview kredīti tikai QA: dealer:10,business:7. Noklusējums / 0 = tukšs atlikums (kā bez pirkuma).
# B2B_PARTNER_SEED_CREDITS=

# IRISS B2B demo (demo.provin.lv, ceļš /b2b-demo). Nav Stripe. Nav PROVIN atskaišu.
# Sesijas sīkdatne: B2B_DEMO_SESSION_SECRET (ja tukšs, krīt uz ADMIN_SECRET; lokāli bez abiem - iebūvēts dev secret).
# Envelope encryption izsoļu sesijām (tikai šifrēts sessionBlob, NE paroles): B2B_DEMO_TENANT_WRAP_SECRET.
# B2B_DEMO_SESSION_SECRET=
# B2B_DEMO_TENANT_WRAP_SECRET=
# Pirmais dīleris: B2B_DEMO_SEED_EMAIL + B2B_DEMO_SEED_PASSWORD (produkcijā obligāti, ja gribi auto-seed).
# Preview bez šiem: vai nu bootstrap forma (ja tenantu 0), vai B2B_DEMO_PREVIEW_SEED=1 + lokālie demo@provin.lv / iriss-b2b-demo.
# B2B_DEMO_SEED_EMAIL=
# B2B_DEMO_SEED_PASSWORD=
# B2B_DEMO_SEED_COMPANY=Demo dīleris
# B2B_DEMO_PREVIEW_SEED=
# Platformas admin tenantiem: /admin/b2b-demo un /api/admin/b2b-demo/* (PROVIN admin sesija).
# Skriptiem: header x-b2b-demo-admin-secret = B2B_DEMO_ADMIN_SECRET (ja tukšs, ADMIN_SECRET, ≥16).
# B2B_DEMO_ADMIN_SECRET=

# Operatora pasūtījums bez apmaksas — slepenā forma `/pasutit?key=…` (≥ 16 rakstzīmes; nepublicēt).
# OPERATOR_ORDER_SECRET=

# Anthropic Claude — admin AI automatizācija (pārdevējs, kopsavilkums, cena, avotu komentāri).
# Atslēga: https://console.anthropic.com/settings/keys — lokāli `.env.local`; Vercel → Environment Variables.
# Modeļi: claude-opus-5 / claude-sonnet-5 — smagākiem komentāriem (pogas Opus / Sonnet).
# Tiers: avotu komentāri pēc noklusējuma Gemini 3 Flash; nobraukums/riski/cena — Sonnet; kopsavilkums — Opus.
# 529 / pārslogojums: viena ķēde opus-5 → sonnet-5 → haiku-4-5 (bez atkārtotas Opus raundas). Timeout nefailovero.
# Prompt caching: sistēmas prompti tiek kešoti (Anthropic cache read ~10 % no input cenas).
# Tirgus/cenu analīze lieto Claude web search rīku — papildus ~$0,01 par meklējumu (līdz 6 vienā izsaukumā).
ANTHROPIC_API_KEY=

# Google Gemini — vieglākiem admin komentāriem (pogas Gemini / Flash).
# Atslēga: https://aistudio.google.com/apikey — lokāli `.env.local`; Vercel → Environment Variables.
# Modeļi: gemini-3-flash-preview (lētais noklusējums), gemini-2.5-pro; 404/503 → 2.5-flash → 2.0-flash, bez jauninājuma uz Pro.
GEMINI_API_KEY=
# Avotu PDF (AutoDNA / CarVertical / dīleris) AI lasījums: sonnet (noklusējums) vai gemini.
# gemini = gemini-3.8-flash lasa pirmais; Sonnet pārņem pie kļūdas, nederīga JSON vai skaidri mazāk ierakstu
# nekā teksta slāņa parseris. Pirms ieslēgšanas: npm run eval:vendor-pdf-models -- <PDF mape>.
# VENDOR_PDF_PRIMARY=sonnet
# 1 = AI admin pogas/API tikai DEMO pasūtījumiem (pēc noklusējuma — visiem).
# AI_DEMO_ONLY=
# Vēsturisko auditu konteksts ✨ ģenerēšanai (citu klientu gatavas atskaites ar līdzīgiem agregātiem). Noklusējums: ieslēgts (1).
# AI_HISTORICAL_REPORTS=0
# AI_HISTORICAL_REPORTS_CACHE_TTL_MS=300000
# AI_HISTORICAL_REPORTS_MAX_DRAFTS=80
# AI_HISTORICAL_REPORTS_MAX_MATCHES=4
# AI_HISTORICAL_REPORTS_MIN_SCORE=24
# Apmācības panelis v2 (kandidāti, apstiprināšana, noraidītie). Noklusējums: izslēgts.
# TRAINING_V2=1
# NEXT_PUBLIC_TRAINING_V2=1
# Garuma/formulējumu v2 (TR 1200-2500, kopsavilkums 500-900, G1-G4). Noklusējums: izslēgts.
# LENGTH_RULES_V2=1

# Tehnisko risku v2 pipeline (karte → Gemini 2.5 Pro LV → Flash QA → lint). Noklusējums: izslēgts.
# TECH_RISK_V2=1
# Avotu salīdzinājums Prepare Draft laikā. Noklusējums: izslēgts (statuss „izslēgts”).
# FLASH MAX poga paliek; tur Avotu salīdzinājums nav atzīmēts.
# PROVIN_AUTO_SOURCES_COMPARISON=1
# EUR joslas tikai no verificētas KB (KB: + datums). Noklusējums: izslēgts.
# ALLOW_COST_BANDS=1

# Outvin API — admin „OFICIĀLĀ DĪLERA DATI” → „Ielādēt no Outvin” (nobraukuma vēsture).
# Swagger 1.0.3: HTTP Basic. B2B: GET /vehicle/{VIN} (1. solis), tad GET /history/{VIN}/{type} — 1=serviss, 2=carfax.
# Izstrādei (mock, bez kredītiem): OUTVIN_BASE_URL=https://virtserver.swaggerhub.com/outvin/Outvin/1.0.3/
# Produkcijā: OUTVIN_BASE_URL=https://www.outvin.com/api/v1/
# History type: Swagger 1.0.3 — tikai 1=serviss, 2=carfax (admin Check & Buy).
OUTVIN_EMAIL=
OUTVIN_PASSWORD=
OUTVIN_BASE_URL=https://virtserver.swaggerhub.com/outvin/Outvin/1.0.3/

# One Auto API — admin OFICIĀLĀ DĪLERA DATI (OEM build sheet / service history / kataloga foto)
# un ASV vēsture (VIN Audit VHR Lite/Full). Dashboard API key + Services ieslēgti.
# Noklusējuma bāze: https://api.oneautoapi.com
# ONEAUTO_API_KEY=
# ONEAUTO_API_BASE_URL=https://api.oneautoapi.com
# Ja dashboard ceļš atšķiras no oficiālā (VHR Lite/Full US):
# ONEAUTO_ASV_VHR_LITE_PATH=/vinaudit/vehiclehistoryreportlite/us
# ONEAUTO_ASV_VHR_PATH=/vinaudit/vehiclehistoryreport/us

# autoDNA WebAPI (sandbox dokumentācija v1.0) — bāzes URL ar /api/ beigās.
# PL/LV: https://api-sandbox.autodna.pl/api/  |  EN: https://api-sandbox.autodna.com/api/
# Maršruti: getReport, orderStatus, download (POST multipart/form-data).
# Auth: `x-api-key` + Basic Auth (lietotājs = e-pasts, parole = API atslēga).
# IP allowlist: Fixie HTTP prokss (Vercel integrācija, ES reģions). Tikai autoDNA `fetch`.
# Integrācija ieliek FIXIE_URL pati. Lokāli: `npx vercel env pull` (necommitē).
FIXIE_URL=
AUTODNA_API_URL=https://api-sandbox.autodna.pl/api/
AUTODNA_EMAIL=
AUTODNA_API_KEY=

# Publiskie valsts reģistri: tjekbil.dk bez captcha; mnt.ee produkcijā caur MNT_RELAY_*; lkf.ee / car.info ar CapSolver.
# VIN_SOURCES_BROWSER=on tikai lokāli (redzams Playwright), ja HTTP ielase neizdodas.
VIN_SOURCES_BROWSER=
# CapSolver (https://dashboard.capsolver.com). lkf.ee no Vercel vajag atslēgu; mnt.ee ar MNT_RELAY_* to vairs neprasa.
# mnt.ee reCAPTCHA v3: ProxyLess (Fixie datacenter neder V3). HTTP vispirms bez Fixie.
# Cloudflare Challenge (stat.vin, LT policija, bid.cars, car.info, mnt.ee): CapSolver
# AntiCloudflareTask VIENMĒR ar proxy (FIXIE_URL vai CAPSOLVER_PROXY). Nav ProxyLess -
# tas tips neeksistē un CapSolver tad prasa websiteKey (HTTP 400).
# FIXIE_URL formāts: http://user:pass@host:port (CapSolver URL/DNS). Colon rezerve kodā.
# lkf.ee reCAPTCHA v2: sticky proxy. Ja FIXIE_URL jau ir autoDNA, to izmanto.
# CAPSOLVER_FORCE_PROXY=1 atjauno mnt.ee veco ceļu (V3 + HTTP caur Fixie). Noklusējums: izslēgts.
# ProxyLess poll: 90 s, viens atkārtojums ja žetons paliek processing. Admin fetch abort: 280 s.
# mnt.ee parastā lapa satur Cloudflare JS bāku (challenge-platform/scripts/jsd) - tas NAV challenge.
# Ja mnt.ee noraida standarta V3 žetonu, viens mēģinājums ar CapSolver M1 (~3 $/k). CAPSOLVER_MNT_V3_M1=0 izslēdz.
# 2026-10-07: mnt.ee noraidīja gan CapSolver standarta, gan M1 žetonu (zems V3 score). Rezerve ar reāliem
# strādniekiem minScore 0.9 rindā: pietiek ar vienu atslēgu (secība Anti-Captcha, 2Captcha, CapMonster).
# Anti-Captcha: https://anti-captcha.com/clients/settings/apisetup  2Captcha: https://2captcha.com/enterpage
# CAPSOLVER_API_KEY=
# Statens vegvesen Autosys (VIN SCAN vegvesen.no). Headeris SVV-Authorization. Bez atslēgas: config_missing.
# VEGVESEN_API_KEY=
# CAPSOLVER_PROXY=host:port:user:pass
# CAPSOLVER_FORCE_PROXY=
# CAPSOLVER_MNT_V3_M1=
# ANTICAPTCHA_API_KEY=
# TWOCAPTCHA_API_KEY=
# CAPMONSTER_API_KEY=

# JoJ API Copart and IAAI (VIN SCAN flīze „Copart/IAAI (JoJ API)” → AUCTION / cc_vin).
# GET /search-vin/{vin}?prices_history=1 $0.50, 1 req/s. Headeris X-JoJAPI-Key (jk_); Bearer also accepted. Server-only.
# OpenAPI: https://jojapi.com/hub/api/copart-and-iaai-api  base https://carstat-copart-iaai.jojapi.net
# Coverage: USA and Canada only (copart.com / iaai.com). Copart FI (copart.fi) is NOT in JoJ.
# 404 = nav ierakstu (kešs 30 dienas). /search-lot tikai ja VIN 404 un lots zināms.
# /usa/damages un /usa/titles: $0.01, kešs 90 dienas.
# Bez atslēgas flīze rāda „nav konfigurēts”, nav kļūda.
# JOJ_API_KEY=
# JOJ_API_BASE_URL=https://carstat-copart-iaai.jojapi.net

# nummerplade.net JSON API — TJEKBIL pogas papildu avots (VIN/numurs).
# VIN SCAN publisko lapu nolasa arī bez atslēgas (Cloudflare caur CapSolver).
# Bezmaksas API: 100 opslag/dienā, headeris X-Api-Noegle. https://www.nummerplade.net/api
# NUMMERPLADE_API_KEY=

# Speckr Customer API (PRO pasūtījums → OFICIĀLĀ DĪLERA DATI, manuāla „Ielādēt (maksas)”).
# POST https://speckr.com/api/v1/vehicle-specs, Bearer spk_live_…, Idempotency-Key. 1 kredīts par veiksmīgu pieprasījumu.
# OpenAPI: https://speckr.com/api/v1/openapi.json — tikai servera env, ne NEXT_PUBLIC_.
# SPECKR_API_KEY=

# PDF vēstures atskaites — serverī `pdfjs-dist/legacy` + lokāls worker (nav PHP/Composer).
# API: POST /api/admin/reports/parse-pdf (multipart `file`, opc. `target`).
# API: POST /api/admin/reports/ai-extract — pagaidām atslēgts (410); admin AI anomāliju sadaļa tiks pārbūvēta.

# Groq (OpenAI-saderīgs Chat API) — sludinājuma „Pārdošanas konteksts” (`llama-3.3-70b-versatile`).
# Atslēga: https://console.groq.com/keys — Lokāli: `.env.local`; pēc pievienošanas restartē `npm run dev`.
# Vercel: Settings → Environment Variables → GROQ_API_KEY.
GROQ_API_KEY=

# Admin melnraksts (JSON): VIN / sludinājums / piezīmes + avotu bloki + IRISS. Portfeļa PDF paliek IndexedDB.
# Noklusējums: .data/admin-order-drafts/ projekta saknē (piem. VPS + `next start`). Izslēgt: ADMIN_ORDER_DRAFT_DIR=off
# Vercel serverless: bez Blob — raksta uz /tmp (PATCH var izdoties), bet dati starp pieprasījumiem nav uzticami. Produkcijai obligāti Blob zemāk.
# KRITISKI: produkcijā neizmanto "off", ja admin avotu formai vajag servera saglabāšanu.
ADMIN_ORDER_DRAFT_DIR=
# Vercel Blob pasūtījumu melnrakstiem — OBLIGĀTI Production (kopā ar BLOB_READ_WRITE_TOKEN).
# Piemērs: ADMIN_ORDER_DRAFT_BLOB_PREFIX=admin-order-drafts/
# Pēc env iestatīšanas: Redeploy → /api/admin/debug/persistence (admin session) jārāda ok+durable.
ADMIN_ORDER_DRAFT_BLOB_PREFIX=admin-order-drafts/

# PROVIN SELECT konsultāciju drafti (JSON). Noklusējums: .data/admin-consultation-drafts.
# Vercel (VERCEL=1) bez šī lauka: automātiski `os.tmpdir()/provin-admin-consultation-drafts` (rakstāms; saturs var pazust starp deploy/cold start).
# Ilgtermiņam: montēts disks, Blob/DB utt., vai explicit ADMIN_CONSULTATION_DRAFT_DIR uz rakstāmu ceļu.
# KRITISKI: neiestatīt "off", ja admin konsultācijā vajag servera autosaglabāšanu.
ADMIN_CONSULTATION_DRAFT_DIR=

# IRISS admin — PAVADZĪMES (CSDD transporta PDF no Dropbox /Pavadzīmes_IRISS, tikai mapes saknes PDF; apakšmape Arhīvs netiek lasīta).
# Serveris lasa mapi ar Dropbox API; parsētie lauki + manuālās PDF augšupielādes: Vercel Blob (BLOB_READ_WRITE_TOKEN) vai .data/iriss-pavadzimes.
# Variants A (īss): ilglaicīgs Dropbox access token (App Console → Generated access token).
DROPBOX_ACCESS_TOKEN=
# Variants B (ieteicams): OAuth refresh. App Console → app key/secret + offline refresh token ar files.metadata.read + files.content.read.
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Tukšs = /Pavadzīmes_IRISS. App Folder tipa lietotnei: atstāj tukšu, ja mape ir lietotnes sakne.
DROPBOX_PAVADZIMES_PATH=/Pavadzīmes_IRISS
# Pavadzīmju Dropbox → Blob sinhronizācija ārpus admin lapas: POST /api/iriss/pavadzimes/sync (header x-sync-secret) un Dropbox webhook.
# ≥ 16 rakstzīmes; nepublicēt. Produkcijā: Vercel Environment Variables.
# PAVADZIMES_SYNC_SECRET=
# Bez Dropbox token: admin Pavadzīmes lapa ļauj manuāli augšupielādēt PDF (+ VIN, ja PDF to nesatur).

# IRISS admin — PASŪTĪJUMI (JSON). Lokāli / next start: .data/iriss-pasutijumi. Vercel: Vercel Blob (privāti), ja ir BLOB_READ_WRITE_TOKEN; ja nav token un nav šī ceļa — melnraksts izslēgts. ADMIN_IRISS_PASUTIJUMI_DIR pārraksta uz disku (piem. montēts volūms). Izslēgt: ADMIN_IRISS_PASUTIJUMI_DIR=0
# Vercel serverless: ceļš ārpus `os.tmpdir()` (piem. Mac/Dropbox absolūtais ceļš no .env.local) tiek ignorēts, lai netraucētu Blob. Reti: ADMIN_IRISS_PASUTIJUMI_VERCEL_FS=1
ADMIN_IRISS_PASUTIJUMI_DIR=
ADMIN_IRISS_PASUTIJUMI_VERCEL_FS=
# IRISS pasūtījumi Blob kešs (ms) — lielāks TTL = mazāk Blob operāciju (piemērots bezmaksas Blob). Kods noklusējums: 600000 / 300000.
IRISS_PASUTIJUMI_BLOB_LIST_CACHE_TTL_MS=600000
IRISS_PASUTIJUMI_BLOB_RECORD_CACHE_TTL_MS=300000
# 0 = pēc noklusējuma nerakstīt backup snapshotus Blob (mazāk operāciju); 1 = ieslēgt.
IRISS_PASUTIJUMI_BLOB_WRITE_BACKUPS=0
# Lokālais spoguļ-snapshots projekta mapē (Dropbox-friendly). Tukšs => .data/iriss-pasutijumi-local-mirror
# Izslēgt: IRISS_PASUTIJUMI_LOCAL_MIRROR_DIR=0
IRISS_PASUTIJUMI_LOCAL_MIRROR_DIR=
# 1 = papildus ģenerēt vienu pilnu backup failu `_all-orders.json` lokālajā spoguļ-mapē.
IRISS_PASUTIJUMI_LOCAL_FULL_BUNDLE=1
# Vercel Blob (read-write) — Storage → Blob → Connect to Project; lokāliem testiem: `vercel env pull`
# Arī admin „nosūtīt klientam” ar lielu portfeli: augšupielāde uz Blob (`/api/admin/notify-blob-upload`), tad e-pasts no servera (apiņot Vercel ~4.5 MB POST limitu vienai API route).
# Tas pats token vajadzīgs avotu PDF, kas lielāki par ~3 MB (AutoDNA / CarVertical / oficiālā dīlera atskaites, `/api/admin/copilot/pdf-blob-upload`) — bez tā šādi faili atgriež HTTP 413.
BLOB_READ_WRITE_TOKEN=
# Sinhronizēt lokālos IRISS pasūtījumus uz Blob (apvieno ar esošajiem): `npm run iriss:merge-to-blob -- --dry-run` tad bez --dry-run. Skat. scripts/iriss-merge-local-to-blob.mjs

# Bezmaksas „ātrie vērtējumi” (listing peek): kad „Gaida atbildi” skaits sasniedz limitu, publiskā forma pauzējas.
# LISTING_PEEK_QUEUE_LIMIT=10

# IRISS admin — SCAN (JSON). Lokāli: .data/iriss-scan. Vercel: Blob prefikss `iriss-scan/`, ja ir BLOB_READ_WRITE_TOKEN (tas pats token kā pasūtījumiem). Ceļš ārpus `os.tmpdir()` deploy vidē tiek ignorēts. Izslēgt: ADMIN_IRISS_SCAN_DIR=0. Reti: ADMIN_IRISS_SCAN_VERCEL_FS=1
ADMIN_IRISS_SCAN_DIR=
ADMIN_IRISS_SCAN_VERCEL_FS=

# Lokālie backup ceļi (projekta saknē — ja projekts ir Dropbox mapē, sinhronizējas ar Dropbox):
# - `<ADMIN_DRAFT_BACKUP_FS_ROOT vai .data/daily-admin-draft-backups>/<YYYY-MM-DD>/` — plānotais cron snapshot (manifest.json + snapshot.json)
# - `.data/iriss-pasutijumi-backups/` — IRISS JSON versiju backupi, kad glabātuve ir FS (ne Blob)
# - `.data/iriss-pasutijumi-local-mirror/` — IRISS spogulis katram saglabājumam lokāli (nav Vercel runtime)
# Vercel serverless: `process.cwd()/.data` bieži nav rakstāms — cron atgriež brīdinājumu; Dropbox backup dara no Mac (eksports) vai norādi ADMIN_DRAFT_BACKUP_FS_ROOT uz VPS rakstāmu ceļu.
ADMIN_DRAFT_BACKUP_FS_ROOT=

# Ikdienas admin draft "restore point" backup cron (vercel.json: katru dienu 02:00 UTC):
# - obligāti ieliec drošu secret (Authorization: Bearer ...)
ADMIN_DRAFT_BACKUP_CRON_SECRET=
# 48 h audita SLA 3 h brīdinājums: /api/cron/admin-audit-sla-warning (vercel.json */15).
# Auth: Bearer = CRON_SECRET vai ADMIN_DRAFT_BACKUP_CRON_SECRET. Kanāli: ADMIN_NOTIFY_EMAIL / SMTP / Telegram.
# Nav jaunu atslēgu. Nav IRISS LIST izsoļu atgādinājums.
# FS: pēc backup dzēš vecākās `YYYY-MM-DD` mapes, paturot tikai jaunākās N (noklusējums 12).
ADMIN_DRAFT_BACKUP_FS_RETENTION=12
# Bezmaksas Blob: noklusējumā NEaugšupielādē snapshot uz Blob (0). 1 = ieslēgt (vairāk operāciju + krātuve).
ADMIN_DRAFT_DAILY_BACKUP_TO_BLOB=0
# Bezmaksas Blob: noklusējumā NEielādē visus order-draft failus no Blob cronā (0). 1 = ieslēgt.
ADMIN_DRAFT_DAILY_BACKUP_INCLUDE_ORDER_BLOB=0
# IRISS Blob (pasūtījumi, SCAN, pavadzīmes) dienas backupā. Noklusējums kodā: ieslēgts. 0 = izslēgt.
ADMIN_DRAFT_DAILY_BACKUP_INCLUDE_IRISS_BLOB=
# Opcionāli Blob prefikss ikdienas snapshotiem (default: admin-daily-backups/) — tikai ja ADMIN_DRAFT_DAILY_BACKUP_TO_BLOB=1
ADMIN_DRAFT_DAILY_BACKUP_BLOB_PREFIX=

# IRISS LIST (Sludinājumi): /admin/iriss/sludinajumi. Katru dienu nolasa aktīvo IRISS pasūtījumu izsoļu
# meklējumus (Autobid un eCarsTrade tieši; Openlane un Auto1 caur Hetzner releju, Fāze 1) un rāda konkrētus auto:
# jaunus, ar mainītu cenu, pazudušus (pēc 2 nolasījumiem pēc kārtas). Mobile.de šajā fāzē nav.
# Storage noklusējums lokāli: .data/iriss-sludinajumi ; Vercel: Blob (BLOB_READ_WRITE_TOKEN). Izslēgt: ADMIN_IRISS_LISTINGS_DIR=off
ADMIN_IRISS_LISTINGS_DIR=
# Opcionāli Blob prefikss (Vercel), piem. iriss-sludinajumi/
ADMIN_IRISS_LISTINGS_BLOB_PREFIX=
# Cron /api/cron/iriss-listings-daily-sync (vercel.json 04, 06, 08, 10 UTC). Viena palaišana nepabeidz 92 avotus
# (virknes pauze 4 s * 91 = 364 s > maršruta 300 s), tāpēc nākamā palaišana turpina atlikušos. Auth: Bearer = šis VAI CRON_SECRET.
ADMIN_IRISS_LISTINGS_CRON_SECRET=
# Autobid: cik meklēšanas lapas (pa 20 auto) lasīt vienam avotam. Kārtošana pēc izsoles sākuma, pirmās lapas ir svarīgākās.
IRISS_LISTINGS_AUTOBID_MAX_PAGES=5
# eCarsTrade (ecarstrade.com): dīlera konts. Lasīšana iet tieši no Vercel caur GET /future_api.php
# (salīmēti JSON + base64 kartītes). Login POST /api/v1/auth/login {username,password} ir vajadzīgs
# krājumiem / fiksētajām cenām (publiski HTML ir „Sign in to buy”, max_bid null; 31 Dec 2036 nav beigas).
# Pēc login: Bearer + Cookie uz future_api un GET /api/v1/cars/{id}. Bez paroles paliek publiskais
# saraksts (tenderu max_bid, bez PIRKT). Excel eksports ir aiz Cloudflare; to nelietojam. Paroles nekad repo.
ECARSTRADE_USER=
ECARSTRADE_PASS=
IRISS_LISTINGS_ECARSTRADE_MAX_PAGES=5
# Timeout vienai lapai (ms); laika budžets visai palaišanai (ms, funkcijai ir 300 s).
IRISS_LISTINGS_FETCH_TIMEOUT_MS=18000
IRISS_LISTINGS_TIME_BUDGET_MS=240000
# Tiešo Autobid lasījumu paralēlisms (1-3). Relejs paliek pa vienam Chrome serverī.
IRISS_LISTINGS_FETCH_CONCURRENCY=3
IRISS_LISTINGS_MAX_SOURCES_PER_RUN=200
# Glabāt neapstrādāto __NUXT_DATA__ (raw/<runId>.json), lai struktūras maiņu var ātri izpētīt. Izslēgt: 0
IRISS_LISTINGS_STORE_RAW=1
# Auto1 VIN no foto (OCR), ja saraksta API VIN nedod. Slinks, kešots, UI „no foto”. Izslēgt: 0
IRISS_LISTINGS_VIN_OCR=1
# Fāze 1: Hetzner relejs (provin-listings, Caddy /listings/* uz csdd-relay.provin.lv) ar ielogotiem Openlane / Auto1 profiliem.
# Paroles nekad repo un nekad Vercel: tikai /etc/provin-listings.env uz servera. Kods: relay/provin-listings/README.md
# URL ar /listings prefiksu, piem. https://csdd-relay.provin.lv/listings ; tokens = servera LISTINGS_RELAY_TOKEN.
# VIN SCAN izsoles (stat.vin, bid.cars, …): POST /listings/page ar šiem pašiem URL/token. Jauns releja kods jāizvieto.
# Admin „Ielogoties” lieto šos pašus: paroles/2FA ievada īpašnieks attālinātajā pārlūkā, Vercel tās neredz.
IRISS_LISTINGS_RELAY_URL=
IRISS_LISTINGS_RELAY_TOKEN=
# Timeout vienam releja fetch (ms, noklusējums 180000; relejs lasa līdz 5 lapām ar pauzēm). Lapu limits relejam.
IRISS_LISTINGS_RELAY_TIMEOUT_MS=180000
IRISS_LISTINGS_RELAY_MAX_PAGES=5
# Autobid caur releju ar ielogotu profilu (redz vairāk cenu) tā vietā, lai lasītu publiski no Vercel. Ieslēgt: 1
IRISS_LISTINGS_AUTOBID_VIA_RELAY=
# eCarsTrade cenas (logged-in /search + detaļas) caur to pašu releju. Inventārs paliek future_api no Vercel.
# ET paroles relejā: ECARSTRADE_USER / ECARSTRADE_PASS (/etc/provin-listings.env). Ieslēgt: 1
IRISS_LISTINGS_ECARSTRADE_VIA_RELAY=
#
# Dīlera datu automātiskā ielase pēc apmaksas (OE Service History).
# Cron: /api/cron/dealer-data-sweep (vercel.json ik 30 min).
# Auth: Authorization Bearer = ADMIN_DEALER_DATA_CRON_SECRET VAI Vercel CRON_SECRET
# (Vercel Cron automātiski sūta CRON_SECRET - pietiek, ja tas ir iestatīts projekta env).
ADMIN_DEALER_DATA_CRON_SECRET=
# Opcionāli: kur glabāt ielases stāvokli. Bez šiem tiek lietots
# ADMIN_ORDER_DRAFT_BLOB_PREFIX + dealer-data-jobs/ un lokālā .data mape.
DEALER_DATA_JOB_BLOB_PREFIX=
DEALER_DATA_JOB_DIR=

# Demo pasūtījumi /admin — noklusējums ieslēgts. Izslēgt: ADMIN_DEMO_ORDERS=0
ADMIN_DEMO_ORDERS=

# Admin alerts — iestatīt vismaz vienu kanālu
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Transakciju e-pasti — tikai Google Workspace SMTP (bez Resend/Mailgun).
# Obligāti aizpildīt SMTP_USER + SMTP_PASS, lai sūtītu: apmaksas apstiprinājumu, „audits gatavs”, u.c.
# Google Account → Security → 2-Step Verification → App passwords → izveido parole „Mail” / „Vercel”.
# SMTP_USER = pilna Workspace adrese (piem. info@provin.lv); SMTP_PASS = 16 rakstu app password.
# Produkcijā: Vercel → Project → Settings → Environment Variables (ne tikai lokālais .env).
# SMTP_FROM (opcionāli): jāsaskan ar Workspace atļauto sūtītāju/alias; noklusējums PROVIN <SMTP_USER>.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PROVIN <info@provin.lv>"
# B2B / IRISS sūtītāja vārds (tā pati SMTP adrese). Bez šī: IRISS <SMTP_USER>.
SMTP_FROM_B2B="IRISS <info@provin.lv>"
SMTP_REPLY_TO=info@provin.lv
#
# E-pasta piegāde (Gmail „Mēstules”) — galvenokārt DNS + Workspace, ne kods:
# – Google Admin → Apps → Google Workspace → Gmail → Authenticate email: ieslēgt SPF/DKIM domēnam provin.lv (seko vednim).
# – SMTP_USER un SMTP_FROM jābūt tai pašai Workspace adresei (vai atļautam aliasam), lai DKIM paraksts sakristu.
# – DMARC: sākumā `v=DMARC1; p=none; rua=mailto:...` (uzraudzība), vēlāk `p=quarantine` vai `reject`.
# – Pirmais tests: nosūtīt uz citu pakalpojumu (ne Gmail), pārbaudīt „Show original” → SPF/DKIM/PASS.
# – Klientam: „Nav mēstule” + pievienot kontaktiem; vairāki identiski testi īsā laikā paši palielina spam score.
#
# /api/admin/notify-report-ready — pielikumu kopējais apjoms ~20 MB (`lib/notify-report-email-limits.ts`). Portfeli var nosūtīt no pasūtījuma darba zonas vai ar failiem no pasūtījumu tabulas.
# Pieprasījuma ķermenis (multipart): Next.js `experimental.middlewareClientMaxBodySize` + `serverActions.bodySizeLimit` — skat. `next.config.ts` (salīdzināti ~24 MB, lai nav agrā 413).
# Jauns apmaksāts pasūtījums — e-pasts adminam (`checkout.session.completed` webhook; skat. DEPLOY.md arī `async_payment_succeeded`).
# Ja tukšs, bet SMTP_USER satur @ — paziņojums tiek sūtīts uz SMTP_USER (parasti info@provin.lv). Citādi iestatīt atsevišķu admin@.
ADMIN_NOTIFY_EMAIL=

# Rīta kopsavilkuma e-pasts (~08:00 Europe/Riga). Cron: /api/cron/morning-summary
# (vercel.json: 05:00 un 06:00 UTC; handleris sūta tikai tad, kad Rīgā ir 08:00).
# Auth: Authorization Bearer CRON_SECRET (Vercel Cron to pievieno automātiski).
# Saņēmējs tikai no šī env (komats, ja vairāki). Nav noklusējuma adreses kodā.
# From: SMTP_FROM / SMTP_USER (produkcijā info@provin.lv).
MORNING_SUMMARY_TO=
# Vercel Cron Bearer (projekta Settings → Environment Variables, ja vēlies manuālu curl).
CRON_SECRET=

# WhatsApp — pilns https://wa.me/371XXXXXXXX (noklusējums: lib/contact.ts)
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/37129502039

# Google Business profils (atsauksmju sadaļa, „Skatīt Google profilā”)
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://share.google/NZamMCLrvxOPi9sy9

# IRISS Google kontakti (People API). Bez visiem trim mainīgajiem saglabāšana ir klusa no-op.
# 1) Google Cloud: Contacts API, OAuth klienta tips Web.
# 2) Authorized redirect URI: https://www.provin.lv/api/admin/google-contacts/oauth/callback
#    (un Preview URL, ja testē).
# 3) Ielogojies /admin, atver /api/admin/google-contacts/oauth, piekrīti, ieliec refresh token šeit.
# GOOGLE_CONTACTS_CLIENT_ID=
# GOOGLE_CONTACTS_CLIENT_SECRET=
# GOOGLE_CONTACTS_REFRESH_TOKEN=

# Vispārīgā saziņa (mailto; adrese lapā netiek drukāta). Produkcijā: info@provin.lv; Reply-To, ja SMTP_REPLY_TO tukšs.
NEXT_PUBLIC_CONTACT_EMAIL=info@provin.lv

# IRISS / Perekupa Dienasgrāmata — sociālie tīkli (pilnas https:// saites; tukšs = noklusējums no `lib/iriss-social-defaults.ts`)
NEXT_PUBLIC_IRISS_TIKTOK_URL=
NEXT_PUBLIC_IRISS_YOUTUBE_URL=
NEXT_PUBLIC_IRISS_INSTAGRAM_URL=

# Sludinājuma cenu vēsture (adify.lv, tirgusdati.lv): abiem priekšā Cloudflare, kas noraida
# datacentra IP (Vercel HTTP 403). `lib/listing-history-relay.ts` mēģina HTTP relejus, tad
# Jina Reader, tad Hetzner Chrome `POST /listings/page` (tie paši IRISS_LISTINGS_RELAY_*).
# Jina Adify neredz (atgriež Just a moment). Chrome relejam vajag allowlist deploy.
# Sava HTTP releja šabloni, ar komatu; `{url}` = neapstrādāta adrese, `{encoded}` = percent-encoded.
LISTING_HISTORY_RELAY_URLS=
# Nosūta kā `x-relay-token` tikai saviem HTTP relejiem (ne Jina, ne Chrome).
LISTING_HISTORY_RELAY_TOKEN=
# Jina atslēga lielākam limitam (nav obligāta; Adify joprojām bloķē Jina IP).
JINA_API_KEY=

# CSDD transportlīdzekļu reģistra web serviss (līgums LĪG-ieņ/375/26).
# `ows.csdd.gov.lv:9999` ir tikai CSDD privātajā tīklā (VPN vai IPSec), tāpēc Vercel to sasniedz
# caur mūsu releju tunelī: `scripts/csdd-relay-server.mjs` uz hosta, ko uzstāda `scripts/csdd-relay-setup.sh`.
# Releja bāzes adrese; var saturēt `{nr1}`, citādi ceļu pieliek klients (`lib/csdd-tech-data.ts`).
CSDD_RELAY_URL=
# Kopīgais tokens ar releju (`openssl rand -hex 32`). CSDD lietotāji paliek tikai uz releja hosta.
CSDD_RELAY_TOKEN=

# eteenindus.mnt.ee (Igaunija) - Hetzner pārlūka relejs. Bez šiem paliek vecais CapSolver HTTP ceļš.
# Produkcijā: Vercel → Environment Variables (Production + Preview), tad Redeploy.
# MNT_RELAY_URL=https://csdd-relay.provin.lv/mnt/lookup
# MNT_RELAY_TOKEN=   # tikai Vercel / .env.local; necommitē
MNT_RELAY_URL=
MNT_RELAY_TOKEN=
