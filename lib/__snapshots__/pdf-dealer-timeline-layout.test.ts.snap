exports[`dealer PDF timeline mileage layout > keeps the km chip in the visit header, not stacked under the date 1`] = `
"<div class="pdf-svc-year-block"><div class="pdf-keep-head"><p class="pdf-svc-year">2026</p><div class="pdf-svc-visit pdf-svc-kind--maintenance">
    <time class="pdf-svc-date">31.03.2026</time>
    <span class="pdf-svc-rail" aria-hidden="true"><span class="pdf-svc-dot"></span></span>
    <article class="pdf-svc-box"><div class="pdf-svc-box-top"><p class="pdf-svc-place">Forchheim</p><span class="pdf-svc-km">214 259 km</span><span class="pdf-svc-tag pdf-svc-tag--maintenance">Apkope</span></div><ul class="pdf-svc-works"><li class="pdf-svc-work">Serviss</li></ul></article>
  </div></div>
</div>"
`;

exports[`dealer PDF timeline mileage layout > print CSS matches the pre-#268 date column: 78px, date not block, km flex chip 1`] = `
{
  "date": "padding:9px 0;font-size:var(--pdf-fs-base);font-weight:600;color:#0f172a; white-space:nowrap;font-variant-numeric:tabular-nums;line-height:1.3;text-align:right;",
  "km": "flex:none;margin-left:auto;padding:3px 8px;border-radius:6px;background:#F1F5F9; font-size:11px;font-weight:700;font-variant-numeric:tabular-nums;color:#0f172a;white-space:nowrap; -webkit-print-color-adjust:exact;print-color-adjust:exact;",
  "visit": "display:grid;grid-template-columns:78px 18px minmax(0,1fr);gap:0 12px;align-items:stretch; break-inside:avoid;page-break-inside:avoid;",
}
`;
