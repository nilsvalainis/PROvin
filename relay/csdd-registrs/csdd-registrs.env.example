# /etc/csdd-registrs.env (root, 600). Vērtības nekad nenonāk repo, žurnālā vai atbildēs.

# PROVIN importētājs (Vercel env IRISS_CSDD_REGISTRS_TOKEN - tā pati vērtība; ģenerē: openssl rand -hex 32)
PROVIN_REGISTRS_URL=https://provin.lv/api/iriss/csdd-registrs
PROVIN_REGISTRS_TOKEN=

# Divas CSDD pieslēgšanās (tās pašas, ko /root/iriss-ttr). Fails: KEY=VALUE (CSDD_USER/CSDD_PASS) vai
# Aivara formāts (1. rinda lietotājs, 2. rinda parole). Vērtības netiek logotas.
CSDD_TTR_ENV_FILE=/root/iriss-ttr/creds
# DZA: kopīgais SIA Autoapkope / SIA Dzintarzeme Auto logins; pēc pieslēgšanās firma kiest_id 5092 (DZINTARZEME AUTO).
CSDD_TTR_ENV_FILE_DZA=/root/iriss-ttr/creds-autoapkope-dza
# REGISTRS_DZA_KIEST_ID=5092
CSDD_USER_VAR=CSDD_USER
CSDD_PASS_VAR=CSDD_PASS
# Playwright no /root/iriss-ttr/node_modules (ja /opt/csdd-registrs nav savs)
IRISS_TTR_DIR=/root/iriss-ttr

# Reģistrs (tikai lasīšana): tirdzniecības atskaite ex('rep_lapt_tl') + #lapt_veids (lib/csdd-session.mjs)
REGISTRS_BASE_URL=https://ows.csdd.gov.lv:7775
REGISTRS_OWNERS=IRISS,DZA
REGISTRS_IGNORE_TLS=1
# REGISTRS_MAX_PAGES=30
# Tīklā POST atļauts TIKAI: pieslēgšanās/firmas izvēles forma (login fāze) un meklēšana rep_lapt_tl šajā adresē
# (read fāze, bez rakstošiem vārdiem). Papildu regex tikai, ja CSDD to prasa (parasti NAV vajadzīgs):
# REGISTRS_LOGIN_POST_RE=
# REGISTRS_READ_POST_RE=

# VPN: tas pats lease kā pavadzīmēm (iriss-vpn-ctl, scripts/iriss-ttr/install-vpn-ctl.sh). Jābūt uzstādītam.
# VPN_CTL_URL=http://127.0.0.1:9334
