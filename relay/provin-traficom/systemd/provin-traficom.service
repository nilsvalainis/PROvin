[Unit]
Description=PROVIN Traficom relay (asiointi.traficom.fi + Suomi.fi eIDAS / eParaksts Mobile), 127.0.0.1:8794
After=network.target provin-traficom-xvfb.service
Requires=provin-traficom-xvfb.service

[Service]
Type=simple
User=provin-traficom
Group=provin-traficom
WorkingDirectory=/opt/provin-traficom
EnvironmentFile=/etc/provin-traficom.env
Environment=DISPLAY=:93
Environment=HOME=/var/lib/provin-traficom
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/provin-traficom/ms-playwright
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/provin-traficom/server.mjs
Restart=always
RestartSec=5
# Lietotāja numurs nedrīkst nonākt žurnālā: serviss to nekad nedrukā, log() to papildus aizvieto ar ***.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=provin-traficom
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/provin-traficom
MemoryMax=900M
TasksMax=256

[Install]
WantedBy=multi-user.target
