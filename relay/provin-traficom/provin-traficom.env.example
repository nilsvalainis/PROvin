# /etc/provin-traficom.env (root, 600). Vērtības nekad nenonāk repo, žurnālā vai atbildēs.

# Abos virzienos (Vercel -> relejs un relejs -> PROVIN atzvans). Vercel env TRAFICOM_RELAY_TOKEN = tā pati vērtība.
# Ģenerē: openssl rand -hex 32
TRAFICOM_RELAY_TOKEN=

# Nila eParaksts Mobile lietotāja numurs. Ieraksta Nils pats. Tikai šeit, nekur citur (nav Vercel, nav repo).
TRAFICOM_EPARAKSTS_USER_NUMBER=

PROVIN_TRAFICOM_CALLBACK_URL=https://www.provin.lv/api/traficom/relay-callback
# TRAFICOM_RELAY_HOST=127.0.0.1
# TRAFICOM_RELAY_PORT=8794
# TRAFICOM_DATA_DIR=/var/lib/provin-traficom
# TRAFICOM_MAX_PER_HOUR=30
# TRAFICOM_MIN_INTERVAL_SEC=30
# TRAFICOM_CACHE_DAYS=7
# TRAFICOM_EPARAKSTS_TIMEOUT_SEC=300
# TRAFICOM_SESSION_TTL_MIN=20
# TRAFICOM_CHROME_CHANNEL=chrome
