# /etc/provin-ltab.env (root, 600). Vērtības nekad nenonāk repo, žurnālā vai atbildēs.

# Abos virzienos (Vercel -> relejs un relejs -> PROVIN atzvans). Vercel env LTAB_RELAY_TOKEN = tā pati vērtība.
# Ģenerē: openssl rand -hex 32
LTAB_RELAY_TOKEN=

# Nila Smart-ID personas kods (formāts 000000-00000). Ieraksta Nils pats no 1Password. Tikai šeit, nekur citur.
SMARTID_PERSONAL_CODE=

PROVIN_LTAB_CALLBACK_URL=https://www.provin.lv/api/ltab/relay-callback
# LTAB_RELAY_HOST=127.0.0.1
# LTAB_RELAY_PORT=8791
# LTAB_DATA_DIR=/var/lib/provin-ltab
# LTAB_MAX_PER_HOUR=20
# Naktī (Rīgas laiks) automātika Smart-ID neprasa; manuālā poga strādā vienmēr.
# LTAB_NIGHT_FROM=22
# LTAB_NIGHT_TO=7
# LTAB_SMARTID_TIMEOUT_SEC=120
# LTAB_CHROME_CHANNEL=chrome
