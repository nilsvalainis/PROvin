# /etc/provin-autodna.env (root, 600). Vērtības nekad nenonāk repo, žurnālā vai atbildēs.

# Abos virzienos (Vercel -> relejs un relejs -> PROVIN atzvans). Vercel env AUTODNA_RELAY_TOKEN = tā pati vērtība.
# Ģenerē: openssl rand -hex 32
AUTODNA_RELAY_TOKEN=

# www.autodna.lv konts (1Password glabātava "Cowork Claude", ieraksts "www.autodna.lv"). Ieraksta galvenais ar op-galv, nekad nedrukā.
# Nils parasti ienāk ar Google - kontam jābūt iestatītai parolei ("Aizmirsi paroli?").
AUTODNA_WEB_EMAIL=
AUTODNA_WEB_PASSWORD=

# "1" = pirkuma poga tiek spiesta. Kamēr nav 1, pirkums ir sauss (viss pārbaudīts, poga netiek spiesta).
# Ieslēgt tikai pēc tam, kad POST /autodna/probe dzīvi parādījis kredītu apmaksas izvēli un vienu apmaksas pogu.
AUTODNA_PURCHASE_LIVE=0

PROVIN_AUTODNA_CALLBACK_URL=https://www.provin.lv/api/autodna/relay-callback
# AUTODNA_RELAY_HOST=127.0.0.1
# AUTODNA_RELAY_PORT=8793
# AUTODNA_DATA_DIR=/var/lib/provin-autodna
# AUTODNA_CHROME_CHANNEL=chrome
# AUTODNA_BALANCE_MIN=30
# AUTODNA_IDLE_CLOSE_MIN=10
