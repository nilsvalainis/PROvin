# /etc/provin-carvertical.env (root, 600). Vērtības nekad nenonāk repo, žurnālā vai atbildēs.

# Abos virzienos (Vercel -> relejs un relejs -> PROVIN atzvans). Vercel env CARVERTICAL_RELAY_TOKEN = tā pati vērtība.
# Ģenerē: openssl rand -hex 32
CARVERTICAL_RELAY_TOKEN=

# CarVertical konts (1Password glabātava "Cowork Claude", ieraksts "Carvertical"). Ieraksta galvenais ar op-galv, nekad nedrukā.
CARVERTICAL_EMAIL=
CARVERTICAL_PASSWORD=

PROVIN_CARVERTICAL_CALLBACK_URL=https://www.provin.lv/api/carvertical/relay-callback
# CARVERTICAL_RELAY_HOST=127.0.0.1
# CARVERTICAL_RELAY_PORT=8792
# CARVERTICAL_DATA_DIR=/var/lib/provin-carvertical
# CARVERTICAL_CHROME_CHANNEL=chrome
# Atlikuma atjaunošana aktīvā sesijā ik N min (jaunu pieteikšanos/kodu nesāk).
# CARVERTICAL_BALANCE_MIN=30
