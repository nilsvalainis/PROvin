# /etc/provin-mnt.env  (root:root, chmod 600). Nekad repo.
# Lasa systemd EnvironmentFile. Komentārs nedrīkst būt tajā pašā rindā, kur vērtība.

# Bearer tokens (>= 32 zīmes), tas pats, kas Vercel MNT_RELAY_TOKEN:
#   openssl rand -hex 32
MNT_RELAY_TOKEN=

# Klausīšanās (noklusējums 127.0.0.1:8788, Caddy /mnt/*)
# MNT_HOST=127.0.0.1
# MNT_PORT=8788

# Pārlūks: "chrome" = sistēmas google-chrome-stable
# MNT_CHANNEL=chrome
# MNT_HEADLESS=0
# MNT_PROFILE_DIR=/var/lib/provin-mnt/profile
# MNT_CACHE_DIR=/var/lib/provin-mnt/cache
# MNT_RECYCLE_AFTER=40
# MNT_ROTATE_AFTER=

# Rinda un laiki
# MNT_TIMEOUT_MS=90000
# MNT_CONCURRENCY=1
# MNT_MAX_QUEUE=6
# MNT_CACHE_TTL_MS=86400000
# MNT_NATIVE_ATTEMPTS=5

# Pārlūka proxy (kopš 17.11.2026 izslēgts - mnt.ee iet tieši caur Hetzner IP).
# Formāts http://lietotajs:parole@host:ports - vērtība tikai šeit, nekad repo.
# MNT_BROWSER_PROXY=

# 2Captcha rezerve (pēc noklusējuma izslēgta; maksas serviss - tikai pēc Nila "jā")
# MNT_TWOCAPTCHA_FALLBACK=0
# TWOCAPTCHA_API_KEY=
