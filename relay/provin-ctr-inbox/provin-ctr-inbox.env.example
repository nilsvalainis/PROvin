# /etc/provin-ctr-inbox.env (root, 600). Vērtības nekad nenonāk repo, žurnālā vai atbildēs.

# PROVIN maršruts (Vercel env CTR_INGEST_TOKEN - tā pati vērtība; ģenerē: openssl rand -hex 32)
CTR_INGEST_URL=https://www.provin.lv/api/ctr/ingest
CTR_INGEST_TOKEN=

# Nila pasts (CheckThisReg e-pasti nāk uz šo kontu). Parole NAV šeit - to katrā gājienā nolasa no 1Password.
CTR_IMAP_HOST=imap.gmail.com
CTR_IMAP_USER=
CTR_OP_CMD=/usr/local/bin/op-galv
# 1Password ieraksta nosaukums ar Gmail IMAP paroli (glabātava CTR_OP_VAULT)
CTR_OP_ITEM=
CTR_OP_VAULT=Cowork Claude

# Stāvoklis (apstrādātie Message-ID): /var/lib/provin-ctr-inbox/seen.json
CTR_STATE_DIR=/var/lib/provin-ctr-inbox
# Cik dienas atpakaļ meklēt e-pastus (CheckThisReg saite derīga 30 d)
CTR_LOOKBACK_DAYS=35
