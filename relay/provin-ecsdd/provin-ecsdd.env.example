# /etc/provin-ecsdd.env (root, 600). Vērtības nekad nenonāk repo, žurnālā vai atbildēs.

# Abos virzienos (Vercel -> relejs un relejs -> PROVIN atzvans). Vercel env ECSDD_RELAY_TOKEN = tā pati vērtība.
# Ģenerē: openssl rand -hex 32
ECSDD_RELAY_TOKEN=

# Nila Smart-ID personas kods (formāts 000000-00000). Ieraksta Nils pats no 1Password. Tikai šeit, nekur citur.
SMARTID_PERSONAL_CODE=

PROVIN_ECSDD_CALLBACK_URL=https://www.provin.lv/api/ecsdd/relay-callback
# ECSDD_RELAY_HOST=127.0.0.1
# ECSDD_RELAY_PORT=8790
# ECSDD_DATA_DIR=/var/lib/provin-ecsdd
# ECSDD_MAX_PER_HOUR=20
# Darba laiks (Rīga): ārpus tā automātika Smart-ID neprasa un sesiju neuztur. Nila poga strādā vienmēr.
# ECSDD_WORK_FROM=8
# ECSDD_WORK_TO=20
# Keep-alive ik N min, kamēr pēdējā uzziņa nav vecāka par IDLE min.
# ECSDD_KEEPALIVE_MIN=4
# ECSDD_KEEPALIVE_IDLE_MIN=240
# Pēc tam, kad Nils pats ielogojas e.csdd (servera sesija izmesta) vai nospiež "Atbrīvot", automātika N min nepiesakās.
# ECSDD_YIELD_MIN=60
# 0 = Smart-ID tikai ar Nila pogu (automātiskās uzziņas gaida, kamēr Nils pieslēdz).
# ECSDD_AUTO_LOGIN=1
# ECSDD_SMARTID_TIMEOUT_SEC=120
# ECSDD_CHROME_CHANNEL=chrome
