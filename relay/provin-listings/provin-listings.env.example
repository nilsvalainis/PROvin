# /etc/provin-listings.env  (root:root, chmod 600). Nekad repo.
# Lasa systemd EnvironmentFile; servisa žurnālā paroles nekad neparādās.

# Bearer tokens, tas pats, kas Vercel IRISS_LISTINGS_RELAY_TOKEN (>= 32 nejaušas zīmes):
#   openssl rand -hex 32
LISTINGS_RELAY_TOKEN=

# Auto-login (sesija beidzas ik pēc pāris stundām). Captcha / 2FA netiek apieta: tad status login_required.
OPENLANE_USER=
OPENLANE_PASS=
AUTOBID_USER=
AUTOBID_PASS=
# Auto1: paroļu nav, tikai pastāvīgs profils (pirmā ielogošanās manuāli caur noVNC).

# Pārlūks
# sistēmas Google Chrome; ja nav, automātiski Playwright Chromium.
# Komentārs nedrīkst būt tajā pašā rindā: systemd EnvironmentFile ieliek to vērtībā.
LISTINGS_CHROME_CHANNEL=chrome
#LISTINGS_CHROME_EXECUTABLE=/usr/bin/google-chrome-stable
LISTINGS_LOCALE=en-GB
LISTINGS_TIMEZONE=Europe/Riga
#LISTINGS_USER_AGENT=

# Limiti
LISTINGS_MAX_PAGES=5
LISTINGS_MAX_FETCHES_PER_DAY=150
LISTINGS_MAX_QUEUE=40
LISTINGS_MANUAL_LOGIN_MINUTES=15

# Openlane bez login tomēr lasīt publiskos datus (daļējas cenas)? 0 = tikai ar login.
OPENLANE_ALLOW_PUBLIC_FALLBACK=1

# Pēc pirmās ielogošanās precizē, ja vajag.
# Openlane /en/login ir 404. Login ir findcar popups, ne atsevišķs login URL.
#OPENLANE_PROBE_URL=https://www.openlane.eu/en/findcar
#OPENLANE_DETAIL_URL_TEMPLATE=https://www.openlane.eu/en/car/{auctionId}
#AUTO1_PROBE_URL=https://www.auto1.com/en/app/merchant/cars?channel=24h&page=1
#AUTO1_LIST_API_RE=/api/.*/vehicles
#AUTOBID_LOGIN_URL=https://autobid.de/en/login

# Ceļi (noklusējumi; parasti nav jāmaina)
#LISTINGS_RELAY_HOST=127.0.0.1
#LISTINGS_RELAY_PORT=8789
#LISTINGS_PROFILES_DIR=/var/lib/provin-listings/profiles
#LISTINGS_STATE_FILE=/var/lib/provin-listings/state.json
